PROJECT_NAME           = TFT_eSPI_ESP8266
PROJECT_NUMBER         = $(PROJECT_VERSION)
PROJECT_BRIEF          = "Graphics library for ESP8266 + ST7789 over SPI"
INPUT                  = src/TFT_eSPI.h src/Extensions/Sprite.h README.md docs/en
FILE_PATTERNS          = *.h *.md
USE_MDFILE_AS_MAINPAGE = README.md
OUTPUT_DIRECTORY       = .build/docs
GENERATE_LATEX         = NO
HAVE_DOT               = NO
ENABLE_PREPROCESSING   = YES
PREDEFINED             = SMOOTH_FONT LOAD_GLCD LOAD_FONT2 LOAD_FONT4 LOAD_FONT6 LOAD_FONT7 LOAD_FONT8 LOAD_GFXFF FONT_FS_AVAILABLE
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
