{
  "name": "TFT_eSPI_ESP8266",
  "version": "1.0.0",
  "keywords": "Arduino, TFT, ST7789, SPI, ESP8266, graphics",
  "description": "SPI TFT graphics library for ESP8266 boards with ST7789 displays",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diaszano/TFT_eSPI_ESP8266"
  },
  "authors": [
    {
      "name": "Bodmer",
      "email": "bodmer@anola.net",
      "url": "https://github.com/Bodmer",
      "maintainer": false
    },
    {
      "name": "Lucas Dias (Diaszano)",
      "email": "61257292+Diaszano@users.noreply.github.com",
      "url": "https://github.com/Diaszano",
      "maintainer": true
    }
  ],
  "frameworks": "arduino",
  "platforms": "espressif8266",
  "headers": "TFT_eSPI.h",
  "export": {
    "exclude": [
      ".build",
      ".pio",
      ".github",
      ".git",
      ".venv",
      ".superpowers",
      "docs/superpowers",
      "tests",
      "test",
      "scripts",
      ".pre-commit-config.yaml",
      ".git-blame-ignore-revs"
    ]
  },
  "examples": [
    "examples/*"
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "srcFilter": [
      "-<*>",
      "+<TFT_eSPI.cpp>"
    ]
  }
}
